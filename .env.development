# Local dev: point at the mock server (sibling repo, run via `npm start`)
NEXT_PUBLIC_API_BASE=http://localhost:3000

# Path layout dispatch:
#   "legacy"     → /api/v1/{tenant}/actions/blueprints/{blueprint}/graph        (mock)
#   "production" → /api/v1/{tenant}/actions/blueprints/{blueprint}/{version}/graph (real Avantos, requires auth)
NEXT_PUBLIC_API_PATH_LAYOUT=legacy

# Identifiers — server-only (no NEXT_PUBLIC_ prefix), consumed by the RSC fetch.
TENANT_ID=1
BLUEPRINT_ID=bp_01jk766tckfwx84xjcxazggzyc

# Required only under "production" path layout. Unused with the local mock.
# BLUEPRINT_VERSION_ID=bpv_123
